PORT=4173
SOLCONTINUITY_ANALYTICS_URL=http://127.0.0.1:8001

# Optional Console security (see README "Console security"). Unset by default:
# the Console stays open to anyone who can reach it, matching the loopback-only default.
# SOLCONTINUITY_CONSOLE_TOKEN=replace-with-high-entropy-secret
# SOLCONTINUITY_COOKIE_SECRET=replace-with-high-entropy-secret
# SOLCONTINUITY_COOKIE_SECURE=1

# GitHub App runtime (use a separate deployment with PORT=4174 or another assigned port)
SOLCONTINUITY_GITHUB_APP_ID=123456
SOLCONTINUITY_GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
SOLCONTINUITY_GITHUB_WEBHOOK_SECRET=replace-with-high-entropy-secret
# Optional: comma-separated override. Defaults to .solcontinuity/manifest.json,solcontinuity.manifest.json,continuity-manifest.json
SOLCONTINUITY_GITHUB_MANIFEST_PATHS=.solcontinuity/manifest.json,solcontinuity.manifest.json,continuity-manifest.json
