{
  "schemaVersion": 1,
  "contract": "juss/buffer-runtime-binding@v1",
  "project": "solcontinuity",
  "repository": "jussray/solcontinuity",
  "authorityOwner": "jussray/founder-control-room",
  "capabilityId": "buffer-publishing-runtime-v1",
  "canonicalPlugin": {
    "repository": "jussray/founder-control-room",
    "path": "plugins/buffer-control",
    "preferredRuntime": "https://mcp.buffer.com/mcp",
    "authentication": "oauth",
    "credentialsStoredInRepository": false
  },
  "role": "verify_and_continuity",
  "invocation": {
    "path": "fcr_shared_capability_runtime",
    "runtimeDiscoveryRequired": true,
    "freshAuthorityCheckBeforeMutation": true,
    "proposalBindingRequiredForMutation": true,
    "providerReceiptRequired": true,
    "providerAcceptanceIsPublished": false
  },
  "allowed": [
    "observe_receipt",
    "verify_provider_state",
    "track_lineage",
    "invalidate_stale_proof",
    "request_readback"
  ],
  "forbidden": [
    "store_buffer_credentials",
    "publish",
    "queue",
    "schedule",
    "edit",
    "delete",
    "manufacture_authority"
  ],
  "rollback": "Disable or ignore this binding; no Buffer credential or provider state is stored here."
}
